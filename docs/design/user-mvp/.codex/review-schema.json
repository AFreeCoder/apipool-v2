{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "prior_findings_status", "open_questions"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "needs-revision"],
      "description": "approve=无未解决 blocker/major,可冻结;needs-revision=存在 blocker/major 需修订"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "一句 ship / no-ship 式总评,而非中性复述"
    },
    "findings": {
      "type": "array",
      "description": "未解决或新增的问题。第 2 轮不要把已解决的 prior finding 放这里(放 prior_findings_status)。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "title", "detail", "anchor", "confidence", "recommendation"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "稳定编号(F1、F2…),供跨轮引用"
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "major", "minor"]
          },
          "category": {
            "type": "string",
            "enum": [
              "codebase-consistency",
              "feasibility",
              "data-api-stateflow",
              "compat-migration",
              "security",
              "performance",
              "maintainability",
              "observability",
              "testing",
              "scope",
              "clarity"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "detail": {
            "type": "string",
            "minLength": 1,
            "description": "什么会出错 / 为什么脆弱 / 影响"
          },
          "anchor": {
            "type": "string",
            "minLength": 1,
            "description": "落点:设计文档章节、或仓库 file:line、或接口/数据结构/数据流/测试名。禁止空泛。"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "把握程度;依赖推断时如实降低"
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "description": "具体、可执行的修改建议"
          }
        }
      }
    },
    "prior_findings_status": {
      "type": "array",
      "description": "仅第 2 轮填写;第 1 轮固定为空数组 []。逐条记录上一轮每个 blocker/major 的解决状态。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "对应上一轮 finding 的 id(如 F1)"
          },
          "status": {
            "type": "string",
            "enum": ["resolved", "partially_resolved", "unresolved"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "判断依据:DESIGN.md 哪处改动证明已解决 / 未解决"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
