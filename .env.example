# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "APIPool"
NEXT_PUBLIC_APP_DESCRIPTION = "Unified API access to OpenAI, Anthropic, and more."
NEXT_PUBLIC_APIPOOL_BRAND_NAME = "APIPool"
NEXT_PUBLIC_APIPOOL_SITE_URL = "https://apipool.dev"
NEXT_PUBLIC_APIPOOL_API_BASE_URL = "https://api2.apipool.dev"
NEXT_PUBLIC_APIPOOL_DEFAULT_MODEL = "gpt-4o-mini"
NEXT_PUBLIC_APIPOOL_SUPPORT_EMAIL = "support@apipool.dev"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER = "sqlite"
DATABASE_URL = "file:data/local.db"
DB_SCHEMA_FILE = "./src/config/db/schema.sqlite.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_sqlite"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = ""

# New API bridge (server-only)
NEWAPI_INTEGRATION_ENABLED = "true"
# Rollback switch: set false to stop new portal key creation while keeping existing key management available.
APIPOOL_KEY_CREATION_ENABLED = "true"
# Required internal service origin. Do not point browser-facing traffic here.
NEWAPI_BASE_URL = "http://newapi-internal:3000"
NEWAPI_ADMIN_TOKEN = ""
NEWAPI_ADMIN_USER_ID = "1"
NEWAPI_QUOTA_PER_UNIT = "500000"
# New API 用户凭据加密密钥（openssl rand -base64 32）
APIPOOL_CREDENTIALS_SECRET = ""

# Portal Gateway / Wallet
GATEWAY_RISK_SLOT_LIMIT = "10"
GATEWAY_OVERDRAFT_FREEZE_MICRO_USD = "10000000"
GATEWAY_MAX_BODY_BYTES = "26214400"
GATEWAY_MAX_INFLIGHT = "16"
GATEWAY_PARSE_BUFFER_MAX = "33554432"
GATEWAY_FIRST_BYTE_TIMEOUT_MS = "120000"
GATEWAY_NONSTREAM_TOTAL_TIMEOUT_MS = "300000"
GATEWAY_STREAM_IDLE_TIMEOUT_MS = "180000"
GATEWAY_HARD_TIMEOUT_MS = "3600000"
GATEWAY_JOBS_ENABLED = "true"
WALLET_LEDGER_WRITE_ENABLED = "false"
WALLET_DISPLAY_ENABLED = "false"
APIPOOL_CHECKOUT_ENABLED = "true"
APIPOOL_API_MODE = "legacy"

# Live MVP smoke test
# Requires an existing portal user and an operator user with APIPool quota permission.
APIPOOL_SMOKE_PORTAL_USER_ID = ""
APIPOOL_SMOKE_OPERATOR_USER_ID = ""
APIPOOL_SMOKE_GROUP_SLUG = "official"
APIPOOL_SMOKE_QUOTA_USD = "1"
APIPOOL_SMOKE_MODEL = "gpt-4o-mini"
APIPOOL_SMOKE_RECHARGE_CENTS = "100"
# 本地直跑网关 smoke 时使用；生产 live-smoke.sh 固定覆盖为容器内地址。
APIPOOL_SMOKE_GATEWAY_BASE_URL = "http://localhost:3000/v1"
# 留空时由 smoke 类型采用各自默认轮询参数。
APIPOOL_SMOKE_USAGE_ATTEMPTS = ""
APIPOOL_SMOKE_USAGE_DELAY_MS = ""
APIPOOL_SMOKE_PRICE_RECONCILIATION = "true"
APIPOOL_SMOKE_PRICE_TOLERANCE_QUOTA = "1"
# Set true in CI/prod validation so missing live credentials fail the command.
APIPOOL_SMOKE_REQUIRE_LIVE = "false"
