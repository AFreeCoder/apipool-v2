# Production server env template.
# Copy to /opt/apipool-v2/.env.deploy and fill secrets there. Do not commit
# the filled file.

COMPOSE_PROJECT_NAME=apipool-v2

DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/data/portal.db
DB_SINGLETON_ENABLED=true
DB_MAX_CONNECTIONS=1

AUTH_SECRET=
APIPOOL_CREDENTIALS_SECRET=

NEWAPI_INTEGRATION_ENABLED=true
APIPOOL_KEY_CREATION_ENABLED=true
NEWAPI_BASE_URL=http://new-api:3000
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=1
NEWAPI_QUOTA_PER_UNIT=500000

# Portal Gateway / Wallet
GATEWAY_RISK_SLOT_LIMIT=10
GATEWAY_OVERDRAFT_FREEZE_MICRO_USD=10000000
GATEWAY_MAX_BODY_BYTES=26214400
GATEWAY_MAX_INFLIGHT=16
GATEWAY_PARSE_BUFFER_MAX=33554432
GATEWAY_FIRST_BYTE_TIMEOUT_MS=120000
GATEWAY_NONSTREAM_TOTAL_TIMEOUT_MS=300000
GATEWAY_STREAM_IDLE_TIMEOUT_MS=180000
GATEWAY_HARD_TIMEOUT_MS=3600000
GATEWAY_JOBS_ENABLED=true
# 打开前置：备份恢复演练证据在案。
WALLET_LEDGER_WRITE_ENABLED=false
WALLET_DISPLAY_ENABLED=false
# fail-closed：必须显式为 true 才开放收款。
APIPOOL_CHECKOUT_ENABLED=true
# APIPOOL_API_MODE: legacy|maintenance|portal（configure-caddy.sh 经 read_env_value 读取）
APIPOOL_API_MODE=legacy

NEWAPI_ROOT_USER=root
NEWAPI_ROOT_PASS=

NEXT_PUBLIC_APP_URL=https://app.apipool.dev
NEXT_PUBLIC_APIPOOL_API_BASE_URL=https://api2.apipool.dev
NEXT_PUBLIC_APIPOOL_DEFAULT_MODEL=gpt-5.4-mini

# VPS-local live smoke. These values are consumed by deploy/live-smoke.sh and
# should stay in /opt/apipool-v2/.env.deploy, not in GitHub Actions secrets.
# Run deploy/setup-smoke-users.sh --apply on the VPS to create/reuse service
# identities and fill the two user id values.
APIPOOL_SMOKE_PORTAL_EMAIL=smoke.portal@apipool.local
APIPOOL_SMOKE_OPERATOR_EMAIL=smoke.operator@apipool.local
APIPOOL_SMOKE_PORTAL_USER_ID=
APIPOOL_SMOKE_OPERATOR_USER_ID=
APIPOOL_SMOKE_GROUP_SLUG=official
APIPOOL_SMOKE_MODEL=
APIPOOL_SMOKE_QUOTA_USD=1
APIPOOL_SMOKE_PRICE_RECONCILIATION=true
APIPOOL_SMOKE_PRICE_TOLERANCE_QUOTA=1

APIPOOL_PORTAL_IMAGE=ghcr.io/afreecoder/apipool-v2
NEWAPI_IMAGE=calciumion/new-api:latest
NEWAPI_METADATA_FILTER_IMAGE=ghcr.io/afreecoder/apipool-v2-newapi-metadata-filter

# New API 运营面（newapi.apipool.dev）保护，至少配一项，否则 configure-caddy.sh
# 拒绝生成配置。Basic Auth 口令哈希用：caddy hash-password --plaintext '<password>'
#
# 【必须用单引号】deploy/live-smoke.sh 会 source 本文件：
#   - bcrypt 哈希含 `$`，不加引号会被 shell 展开成 `a4`，basic_auth 谁也登不上；
#   - IP 白名单含空格，不加引号会让 shell 把第二个 IP 当命令执行，
#     在 set -e 下直接中断部署。
# configure-caddy.sh 自己按字面量读取，加不加引号都能正确解析。
APIPOOL_NEWAPI_BASIC_AUTH_USER='ops'
APIPOOL_NEWAPI_BASIC_AUTH_HASH=''
# 空格分隔的 IP / CIDR，例如：'203.0.113.7 198.51.100.0/24'
APIPOOL_NEWAPI_ALLOWED_IPS=''
