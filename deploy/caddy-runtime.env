# APIPool 共享 Caddy 运行时唯一事实源。
#
# 官方 v2.11.4 预编译产物使用 Go 1.26.3；GO-2026-5856 要求 Go 1.26.5。
# 因此生产二进制由官方 buildable artifact + 官方 Go 工具链离线 vendor 构建，
# 并同时钉住输入和可复现输出的 SHA-256。
APIPOOL_CADDY_VERSION="v2.11.4"
APIPOOL_CADDY_GO_VERSION="go1.26.5"
APIPOOL_CADDY_RUNTIME_ID="2.11.4-go1.26.5"
APIPOOL_CADDY_RUNTIME_CONTRACT="apipool-caddy-runtime-v1"

APIPOOL_CADDY_SOURCE_URL="https://github.com/caddyserver/caddy/releases/download/v2.11.4/caddy_2.11.4_buildable-artifact.tar.gz"
APIPOOL_CADDY_SOURCE_SHA256="33777097f666d60d78bfb74df06978c933f32aa5a0d4ce0b0c5d028489984187"

APIPOOL_CADDY_GO_URL="https://go.dev/dl/go1.26.5.linux-amd64.tar.gz"
APIPOOL_CADDY_GO_SHA256="5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053"

APIPOOL_CADDY_BINARY_SHA256="a085332752dc2cbfb72c4a19040c8d34975467e52a0de44bd59569df0e2c49d9"
APIPOOL_CADDY_RUNTIME_DIR="/usr/local/lib/apipool-caddy"
APIPOOL_CADDY_BIN="$APIPOOL_CADDY_RUNTIME_DIR/caddy-$APIPOOL_CADDY_RUNTIME_ID"

APIPOOL_CADDY_GRACE_PERIOD="15m"
APIPOOL_CADDY_STREAM_CLOSE_DELAY="15m"
APIPOOL_CADDY_TIMEOUT_STOP_SEC="16min"
APIPOOL_CADDY_RELOAD_STABILITY_SECONDS="5"
APIPOOL_CADDY_EXTERNAL_GATE_TIMEOUT_SECONDS="180"
APIPOOL_CADDY_WEBSOCKET_LOOKBACK_SECONDS="86400"

APIPOOL_CADDY_CANDIDATE_HTTP_PORT="18080"
APIPOOL_CADDY_CANDIDATE_HTTPS_PORT="18443"
APIPOOL_CADDY_CANDIDATE_ADMIN="127.0.0.1:2020"
